# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# Database
DB_PASSWORD=YourStrong!Passw0rd
DB_NAME=AutoPartShopDb

# JWT
JWT_SECRET=YourSuperSecretKeyForJWTTokenGenerationMustBe32CharsLong!@#
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_DAYS=7

# Twilio (SMS / WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_SID=
TWILIO_WHATSAPP_SID=

# SMTP (Email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SujanMotors

# Business day — minutes to add to UTC for the shop's calendar (360 = UTC+6, Bangladesh).
# Dashboard and report date windows follow this, not the server clock.
SHOP_TZ_OFFSET_MINUTES=360

# Rate limiting (per minute). RATE_LIMIT_ENABLED is the kill switch: flip and restart.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=10
RATE_LIMIT_SESSION=60
RATE_LIMIT_PUBLIC=60
RATE_LIMIT_GLOBAL=600

# Client IP recovery, which the per-IP limits depend on.
# FORWARDED_HOP_COUNT: nginx alone = 1; Cloudflare or an LB in front of nginx = 2.
# FORWARDED_KNOWN_NETWORK: CIDR of the proxy to trust (Docker bridge subnet by default).
FORWARDED_HOP_COUNT=1
FORWARDED_KNOWN_NETWORK=172.16.0.0/12
