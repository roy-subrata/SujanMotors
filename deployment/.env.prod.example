# =============================================================================
# PRODUCTION ENVIRONMENT — Environment Variables Template
# =============================================================================
#
# SETUP INSTRUCTIONS:
#   1. Copy this file to .env in the SAME directory:
#        cp .env.prod.example .env
#   2. Fill in ALL real values below (use strong passwords!)
#   3. The .env file is gitignored — NEVER commit it to version control
#
# WHERE THIS IS USED:
#   This file provides secrets to docker-compose.yml on the VPS.
#   The production stack lives at: /opt/sujanmotors/
#   Apply with: docker compose --env-file deployment/.env -f deployment/docker-compose.yml -f deployment/docker-compose.prod.yml up --build -d
#
# ⚠️  SECURITY NOTES:
#   - Use a STRONG, UNIQUE DB_PASSWORD (not the default!)
#   - Generate a real JWT_SECRET (random 64+ char string)
#   - All Twilio/SMTP credentials should be real production credentials
#   - This file should ONLY exist on the VPS, never in version control
#
# =============================================================================

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SA_PASSWORD: SQL Server SA account password
#   - Must meet SQL Server complexity requirements (8+ chars, uppercase, lowercase, number, special char)
#   - Use a DIFFERENT password than test environment!
DB_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# DB_NAME: Name of the SQL Server database
#   - Auto-created on first API startup (migrations run automatically)
DB_NAME=AutoPartShopProdDb

# ---------------------------------------------------------------------------
# JWT (JSON Web Token) Authentication
# ---------------------------------------------------------------------------
# JWT_SECRET: Key used to sign JWT tokens (must be 32+ characters)
#   - Generate with: openssl rand -base64 64
#   - ⚠️  MUST be different from the test environment secret!
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING

# JWT_EXPIRY_MINUTES: How long an access token is valid (in minutes)
JWT_EXPIRY_MINUTES=60

# JWT_REFRESH_DAYS: How long a refresh token is valid (in days)
JWT_REFRESH_DAYS=7

# ---------------------------------------------------------------------------
# Twilio (SMS / WhatsApp notifications)
# ---------------------------------------------------------------------------
# Required for order status notifications. Get from twilio.com console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_SID=
TWILIO_WHATSAPP_SID=

# ---------------------------------------------------------------------------
# SMTP (Email notifications)
# ---------------------------------------------------------------------------
# Required for email notifications (order confirmations, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SujanMotors

# Seed settings — auto-create admin user on first run
SEED_ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# ---------------------------------------------------------------------------
# Business day
# ---------------------------------------------------------------------------
# SHOP_TZ_OFFSET_MINUTES: minutes to add to UTC to get the shop's wall clock.
#   360 = UTC+6 (Bangladesh). Dashboard "Today" and report date windows use this,
#   so the day rolls over at local midnight instead of 06:00 local.
SHOP_TZ_OFFSET_MINUTES=360

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
# RATE_LIMIT_ENABLED: master switch. Set to false and restart the API if the limits
#   ever misfire during trading hours — no rebuild needed.
RATE_LIMIT_ENABLED=true

# Limits are requests per minute.
#   AUTH    - login (per client IP). Stacks with Identity lockout: 5 wrong passwords
#             locks the account for 15 minutes regardless of this value.
#   SESSION - token refresh + logout (per client IP). Higher than AUTH on purpose:
#             the whole shop shares one IP and sessions expire together, so renewals
#             arrive in bursts. Too low and staff get signed out mid-shift.
#   PUBLIC  - anonymous endpoints: invoice print data, file downloads (per client IP).
#   GLOBAL  - everything else, per authenticated USER (not IP), so tills sharing one
#             connection do not throttle each other.
RATE_LIMIT_AUTH=10
RATE_LIMIT_SESSION=60
RATE_LIMIT_PUBLIC=60
RATE_LIMIT_GLOBAL=600

# ---------------------------------------------------------------------------
# Reverse proxy / client IP
# ---------------------------------------------------------------------------
# The per-IP limits above are only correct if the API can see the real client IP.
# nginx forwards it in X-Forwarded-For (see src/AutoPartShop.WebApp/nginx.conf).
#
# FORWARDED_HOP_COUNT: how many proxy hops to walk back.
#   1 = nginx is the only proxy.
#   2 = Cloudflare / a load balancer sits IN FRONT of nginx.
#   ⚠️  Getting this wrong is silent: every visitor buckets under the upstream
#      proxy's address and the anonymous limits throttle the whole shop at once.
FORWARDED_HOP_COUNT=1

# FORWARDED_KNOWN_NETWORK: CIDR range of the proxy that may set X-Forwarded-For.
#   Docker gives the nginx container an unstable address, so trust the bridge subnet.
#   Check yours with: docker network inspect sujanmotors-prod_default | grep Subnet
#   Leave blank ONLY if the proxy address cannot be pinned — the header is then
#   accepted from anyone and client IPs can be forged (warned at startup).
FORWARDED_KNOWN_NETWORK=172.16.0.0/12

# ---------------------------------------------------------------------------
# Database backups → Google Drive
# ---------------------------------------------------------------------------
# GDRIVE_SA_KEY_JSON: the FULL service-account key JSON (single line).
#   - Create a Google Cloud service account, enable the Drive API, download the JSON key.
#   - Share a Drive folder with the service account email (Editor), then set the folder id
#     on the admin Backups page. Leave blank to keep backups local-only.
#   - Wrap in single quotes: GDRIVE_SA_KEY_JSON='{"type":"service_account",...}'
# Also create the shared backup folder before first run (mssql runs as UID 10001):
#   mkdir -p deployment/backups && chown 10001:0 deployment/backups
GDRIVE_SA_KEY_JSON=
