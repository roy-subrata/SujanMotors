<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
    <!-- NetArchTest.Rules transitively pulls System.Security.Cryptography.Xml 10.0.9, which has
         several published high-severity advisories (GHSA-23rf-6693-g89p and others). Pin to the
         next patch release, which fixes them, until NetArchTest bumps its own dependency. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10" />
    <PackageReference Include="Testcontainers" Version="4.3.0" />
    <PackageReference Include="Testcontainers.MsSql" Version="4.3.0" />
    <!-- Direct pin to override Testcontainers' transitive SSH.NET 2024.2.0
         (known HIGH severity CVE-2026-48798 / GHSA-q939-rpr3-3284, fixed
         in 2026.0.0). Remove once Testcontainers ships a fixed version. -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- Runner settings: caps test-collection parallelism so Testcontainers'
         MsSql containers don't exhaust Docker under load (see file comments). -->
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoPartShop.Domain\AutoPartShop.Domain.csproj" />
    <ProjectReference Include="..\AutoPartShop.Infrastructure\AutoPartShop.Infrastructure.csproj" />
    <ProjectReference Include="..\AutoPartShop.Api\AutoPartShop.Api.csproj" />
  </ItemGroup>

</Project>