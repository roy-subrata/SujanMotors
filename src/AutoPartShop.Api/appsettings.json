{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "Cors": {
        // Explicit cross-origin allow-list applied in non-Development environments.
        // List every frontend origin (scheme + host + port) that may call this API,
        // e.g. "https://shop.example.com". Development ignores this and echoes any origin.
        "AllowedOrigins": []
    },
    "JwtSettings": {
        // SecretKey must be supplied per-environment via user-secrets (dev),
        // environment variables, or a secrets vault. Never commit a real key.
        "SecretKey": "",
        "Issuer": "AutoPartShopAPI",
        "Audience": "AutoPartShopClient",
        "ExpiryInMinutes": 60,
        "RefreshTokenExpiryInDays": 7
    },
    "ConnectionStrings": {
        // Supplied per-environment (appsettings.Development.json for local dev,
        // env vars / vault for production). Do not commit production credentials.
        "AutoPartDb": ""
    },
    "Seq": {
        // Serilog log shipping to Seq (structured-log UI). Leave Url blank to log to the
        // console only; set it (e.g. "http://localhost:5341" locally, "http://seq:5341" in
        // Docker, env var Seq__Url) to also ship logs. ApiKey is optional (Seq__ApiKey).
        "Url": "",
        "ApiKey": "",
        "ServiceName": "autopartshop-api"
    },
    "Backup": {
        // Database backup paths. Backups are staged in SQL Server's default backup directory and
        // pulled to the API over the SQL connection, so Directory can be any folder the API can
        // write. Restores go the other way: the API puts the .bak in a folder SQL Server can READ,
        // so Directory must be shared with the SQL container and SqlServerDirectory is that same
        // folder as SQL Server sees it (container path).
        // Schedule/retention/Drive-folder are admin-editable ApplicationSettings (BACKUP category).
        "Directory": "",
        "SqlServerDirectory": "/var/opt/mssql/backups"
    },
    "GoogleDrive": {
        // Service-account credential for backup uploads. Provide ONE of these per environment
        // (env vars GoogleDrive__ServiceAccountKeyJson / GoogleDrive__ServiceAccountKeyPath).
        // The admin shares a Drive folder with the service account email as Editor.
        "ServiceAccountKeyPath": "",
        "ServiceAccountKeyJson": ""
    },
    "RateLimiting": {
        // Three tiers (see Api/Middleware/RateLimiting.cs):
        //   auth    - staff login + customer register/login, per client IP
        //   session - token refresh / logout, per client IP; roomier than auth because a
        //             whole shop shares one IP and staff sessions expire in step
        //   public  - the [AllowAnonymous] data endpoints, per client IP
        //   global  - everything else, per authenticated user; generous by design
        // Windows are in seconds. Set Enabled=false to switch limiting off entirely.
        "Enabled": true,
        "AuthPermitLimit": 10,
        "AuthWindowSeconds": 60,
        "SessionPermitLimit": 60,
        "SessionWindowSeconds": 60,
        "PublicPermitLimit": 60,
        "PublicWindowSeconds": 60,
        "GlobalPermitLimit": 600,
        "GlobalWindowSeconds": 60
    },
    "ForwardedHeaders": {
        // The API sits behind a reverse proxy (nginx on the VPS; App Service / Cloudflare on
        // Azure), so the real client IP arrives in X-Forwarded-For. Without this every caller
        // shares the proxy's address and the per-IP rate limits above apply to the shop at once.
        //
        // ForwardLimit = how many proxy hops to walk, right to left. nginx appends via
        // $proxy_add_x_forwarded_for, so: nginx alone = 1; Cloudflare or an LB in front of
        // nginx = 2. Too low and every visitor buckets under the upstream proxy's address.
        //
        // Leaving BOTH lists empty trusts the header from anyone, so a caller can forge an IP
        // and sidestep the per-IP tiers (unavoidable on Azure, where the front end is not
        // fixed; logged as a warning at startup). On Docker, pin the hop instead:
        //   KnownNetworks: ["172.16.0.0/12"]   <- the bridge subnet; container IPs are not stable
        //   KnownProxies:  ["10.0.0.5"]        <- only where the proxy address IS fixed
        "Enabled": true,
        "KnownProxies": [],
        "KnownNetworks": [],
        "ForwardLimit": 1
    },
    "Shop": {
        // Business-day timezone. Timestamps are stored in UTC, but dashboard and report date
        // windows must follow the shop's calendar day: TzOffsetMinutes is added to UTC to get
        // the shop's wall clock (360 = UTC+6, Bangladesh). Fixed offset, no DST.
        "TzOffsetMinutes": 360
    },
    "ReorderAlerts": {
        // Daily staff broadcast (SignalR bell) listing items at/below their reorder level.
        // LocalTime is the shop's wall clock; TzOffsetMinutes shifts UTC (360 = UTC+6, Bangladesh).
        "Enabled": true,
        "LocalTime": "09:30",
        "TzOffsetMinutes": 360
    },
    "Twilio": {
        // Supplied per-environment via appsettings.Development.json (gitignored) for local dev,
        // or env vars / vault in production (Twilio__AccountSid, Twilio__AuthToken, etc.).
        // Never commit real Twilio credentials to this tracked file.
        "AccountSid": "",
        "AuthToken": "",
        "SmsMsgServiceSid": "",
        "WhatsAppMsgServiceSid": ""
    },
    "Smtp": {
        "Host": "",
        "Port": "587",
        "Username": "",
        "Password": "",
        "FromEmail": "",
        "FromName": "SujanMotors",
        "UseSsl": "false"
    },
    "sms":{
        // Supplied per-environment (appsettings.Development.json locally, env var sms__apiKey in prod).
        // Never commit a real SMS API key to this tracked file.
        "apiKey": ""
    },
    "FileStorage": {
        // Uploaded files (product media, employee photos/documents).
        // Local: blobs live under RootPath (default {ContentRoot}/App_Data/uploads).
        // On the VPS, bind-mount RootPath into the container so files survive rebuilds,
        // and include it in the backup strategy alongside the database.
        // PublicBaseUrl (optional): absolute prefix for returned file URLs, e.g.
        // "https://api.example.com" — leave empty to return relative URLs.
        "Provider": "Local",
        "PublicBaseUrl": "",
        "Local": {
            "RootPath": ""
        }
    },
    "Embedding": {
        // Product semantic search. Leave BaseUrl blank to disable (search falls back to keyword).
        // OpenAI-compatible: BaseUrl is the host root (e.g. "https://api.openai.com" or "http://localhost:11434").
        // Provide ApiKey via user-secrets / env (Embedding__ApiKey). Dimensions must match the
        // vector(N) column (default 1536 = text-embedding-3-small); changing it requires a migration.
        "Provider": "openai",
        "BaseUrl": "",
        "ApiKey": "",
        "Model": "text-embedding-3-small",
        "Dimensions": 1536
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft.AspNetCore": "Warning",
                "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
                "Microsoft.EntityFrameworkCore.Infrastructure": "Warning"
            }
        }
    }
}
